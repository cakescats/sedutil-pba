{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CakesCats Drives",
  "version": "0.1.0",
  "identifier": "com.cakescats.drives",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CakesCats Drives",
        "width": 1040,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "CakesCats",
    "copyright": "GPL-3.0-or-later. sedutil: Bright Plaza Inc.",
    "category": "Utility",
    "shortDescription": "Self-encrypting drive manager",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/sedutil-cli"]
  }
}
