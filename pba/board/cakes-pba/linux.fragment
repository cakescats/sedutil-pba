# CakesCats PBA kernel, applied on top of the x86_64 defconfig.
# Goal: find every SATA/NVMe drive and keyboard on current laptops and
# desktops, draw on the firmware framebuffer, and nothing else.

# --- boot
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_XZ=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PRINTK_TIME=n

# --- storage
CONFIG_BLK_DEV_NVME=y
CONFIG_VMD=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_CHR_DEV_SG=y
CONFIG_BLK_SED_OPAL=y

# --- keyboards: PS/2, USB (incl. behind USB4/Thunderbolt docks), I2C HID
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB4=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HID_LOGITECH=y
CONFIG_HID_LOGITECH_DJ=y
CONFIG_HID_APPLE=y
CONFIG_I2C=y
CONFIG_I2C_HID_ACPI=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_PCI=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_PINCTRL_TIGERLAKE=y
CONFIG_PINCTRL_ALDERLAKE=y
CONFIG_PINCTRL_METEORLAKE=y
CONFIG_PINCTRL_AMD=y

# --- display: firmware framebuffer only. GPU drivers take over the
# screen and are a common reason PBA images hang on new hardware.
CONFIG_DRM=n
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_FB_EFI=y
CONFIG_FB_VESA=y
CONFIG_SYSFB_SIMPLEFB=n
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y
CONFIG_LOGO=n

# --- filesystems for key files on USB sticks (later features)
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# --- TPM, for later TPM-bound unlock
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y

# --- network: wired drivers built as modules for later features, never
# loaded unless the PBA asks (there is no udev/mdev to autoload them)
CONFIG_MODULES=y
CONFIG_E1000=m
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_R8169=m
CONFIG_TIGON3=m
CONFIG_SKY2=m
CONFIG_FORCEDETH=m
CONFIG_8139TOO=m
CONFIG_USB_NET_DRIVERS=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_RTL8152=m
CONFIG_WLAN=n
CONFIG_WIRELESS=n
CONFIG_CFG80211=n
CONFIG_MAC80211=n
CONFIG_BT=n

# --- not needed in a PBA
CONFIG_SOUND=n
CONFIG_NFS_FS=n
CONFIG_ROOT_NFS=n
CONFIG_NETFILTER=n
CONFIG_AGP=n
CONFIG_HIBERNATION=n
CONFIG_SUSPEND=n
